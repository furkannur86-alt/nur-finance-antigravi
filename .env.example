# NUR Finance AntiGravi — Environment Variables
# Copy this file to .env.local and fill in your keys

# Market Data (Required)
EODHD_API_TOKEN=your_eodhd_token_here
FRED_API_KEY=your_fred_api_key_here

# Database (Required for data persistence)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI (Optional — enables AI analysis panel)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Video Production (Optional — enables HeyGen avatar videos)
# HEYGEN_API_KEY=your_heygen_key_here

# Piper TTS (Optional — offline neural voice, set path to model directory)
# PIPER_MODELS_DIR=/path/to/piper_models
# PIPER_BIN=piper
